.fvec projection[4]
.fvec view[4]
.constf ones(1.0, 1.0, 1.0, 1.0)
.alias position v0
.alias uv v1
.out outpos position
.out outuv texcoord0
.proc main
    mov r0.xyz, position
    mov r0.w, ones.w
    dp4 r1.x, view[0], r0
    dp4 r1.y, view[1], r0
    dp4 r1.z, view[2], r0
    dp4 r1.w, view[3], r0
    dp4 outpos.x, projection[0], r1
    dp4 outpos.y, projection[1], r1
    dp4 outpos.z, projection[2], r1
    dp4 outpos.w, projection[3], r1
    mov outuv, uv
    end
.end
